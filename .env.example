# Jira Cloud
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=your-jira-api-token-here
JIRA_WEBHOOK_SECRET=your-webhook-secret-here
JIRA_TARGET_STATUS=Ready for Test
JIRA_AC_CUSTOM_FIELD=customfield_10034   # find yours at /rest/api/3/field
PROJECT_KEY=SCRUM

# Zephyr Scale (SmartBear)
ZEPHYR_API_TOKEN=your-zephyr-api-token-here
ZEPHYR_BASE_URL=https://api.zephyrscale.smartbear.com/v2

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional tuning
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=8192
LOG_LEVEL=INFO
LOG_FORMAT=text   # set to "json" for structured JSON logs (e.g. in production/cloud)
OUTPUT_DIR=output  # directory for generated .feature and _report.json files
